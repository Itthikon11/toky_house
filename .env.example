# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงจาก Supabase (Project Settings > API)
# ถ้าไม่ใส่ ระบบจะใช้ข้อมูลตัวอย่าง (mock) ให้ดู UI ได้ทันที
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# รหัสผ่านแอดมิน (ใช้ตอน login หน้าแอดมิน)
VITE_ADMIN_PASSWORD=admin1234
